#it under the terms of the GNU Affero General Public License as published by
#the Free Software Foundation, either version 3 of the License, or
#(at your option) any later version.
#
#This program is distributed in the hope that it will be useful,
#but WITHOUT ANY WARRANTY; without even the implied warranty of
#MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#GNU Affero General Public License for more details.
#
#You should have received a copy of the GNU Affero General Public License
#along with this program.  If not, see <https://www.gnu.org/licenses/>.

coloroff='\e[0m';
black='\e[0;30m';
blue='\e[0;34m';
cyan='\e[0;36m';
green='\e[0;32m';
purple='\e[0;35m';
red='\e[0;31m';
white='\e[0;37m';
yellow='\e[0;33m';

if [ "$(/usr/bin/id -u)" -eq "0" ]; then
	if [ -f "/usr/lib/systemd/system/zram-swap.service" ]; then
		echo -e "Enabling zram-swap";
		systemctl enable zram-swap.service --now; #XXX: replaced by systemd-zram-generator
	fi;

	if [ -f "/usr/lib/systemd/system/fstrim.timer" ]; then
		echo -e "Enabling weekly fstrim";
		systemctl enable fstrim.timer --now;
	fi

	#Repos
	if [ -f /etc/fedora-release ] || [ -f /etc/centos-release ]; then
		echo -e "${cyan}Enabling RPM Fusion, Divested RPM, & replacing system Flathub with user Flathub...${coloroff}";
		echo -e "${red}Please verify the RPM Fusion signing keys from here: https://rpmfusion.org/keys${coloroff}";
		echo -e "Free - F33-41: ${yellow}E9A4 91A3 DE24 7814 E7E0 67EA E06F 8ECD D651 FF2E${coloroff}";
		echo -e "Free - EL9: ${yellow}EDC0 0FE7 418C 9DF7 EF49  91A4 7403 EA33 2964 58F3${coloroff}";
		echo -e "Free - EL8: ${yellow}8379 35CD 19E1 23AA 7F8A  8E69 979F 0C69 158B 3811${coloroff}";
		echo -e "Free - EL7: ${yellow}DB9A 9A57 CAFD 23DA 3A88  792F 758B 3D18 F5CF 6C1E${coloroff}";
		echo -e "Nonfree - ${yellow}F33-41: 79BD B88F 9BBF 7391 0FD4 095B 6A2A F961 9484 3C65${coloroff}";
		echo -e "Nonfree - ${yellow}EL9: BB24 128A 4BB3 C335 2C0B  75A2 E417 4E6B AAB2 12EA${coloroff}";
		echo -e "Nonfree - ${yellow}EL8: CF9F D59F 61D6 6121 46CD AC8E 14B6 792D BDDA 8475${coloroff}";
		echo -e "Nonfree - ${yellow}EL7: C3FA F3A9 6B39 8583 91ED  D8D9 C8F7 6DF1 A310 8F6C${coloroff}";
	fi

	if [ -f /etc/fedora-release ]; then

		echo -e "${red}Cleaning up DNF...${coloroff}";
		dnf autoremove;
		dnf clean all;

		echo -e "${red}Updating DNF Cache...${coloroff}";
		dnf update --refresh;

		dnf remove fedora-third-party fedora-workstation-repositories;
		dnf install "https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm";
		dnf install "https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm";
		dnf install rpmfusion-free-release-tainted;
		dnf install rpmfusion-nonfree-release-tainted;
		wget https://gitlab.com/divested/divested-release/-/jobs/7046900191/artifacts/raw/build/noarch/divested-release-20240607-1.noarch.rpm;
		dnf install divested-release-20240607-1.noarch.rpm;
		dnf remove fedora-flathub-remote;

		echo -e "${red}Updating DNF Cache...${coloroff}";
		dnf update --refresh;

		echo -e "${red}Updating Flatpak Cache...${coloroff}";
		flatpak --system update;
		flatpak --user update;

		flatpak remote-delete --system fedora;
		flatpak remote-delete --system flathub;
		flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo;

		echo -e "${red}Updating Flatpak Cache...${coloroff}";
		flatpak --system update;
		flatpak --user update;

		echo -e "${red}Cleaning up DNF...${coloroff}";
		dnf autoremove;
		dnf clean all;

	elif [ -f /etc/centos-release ]; then
		yum install epel-release;
		yum localinstall --nogpgcheck "https://download1.rpmfusion.org/free/el/rpmfusion-free-release-$(rpm -E %centos).noarch.rpm";
		yum localinstall --nogpgcheck "https://download1.rpmfusion.org/nonfree/el/rpmfusion-nonfree-release-$(rpm -E %centos).noarch.rpm";
	fi

	if [ -d "/etc/yum.repos.d" ]; then
		echo -e "${cyan}Setting DNF repos to use HTTPS...${coloroff}";
		sed -i 's/metalink?repo=/metalink\?protocol\=https\&repo\=/' /etc/yum.repos.d/*.repo;

		echo -e "Remember: This will need to be done again if any of them are updated!";

		echo -e "${cyan}Disabling DNF countme...${coloroff}";
		sed -i 's/countme=1/countme=0/' /etc/yum.repos.d/*.repo;
		sed -i '$a countme=False' /etc/dnf/dnf.conf;

		echo -e "Speeding up DNF...";
		sed -i '$a max_parallel_downloads=10' /etc/dnf/dnf.conf;
	fi

	#FWUPD
	if [ -x /usr/bin/fwupdmgr ]; then
		echo -e "${cyan}Setting FWUPD to use HTTPS...${coloroff}":
		echo -e 'UriSchemes=file;https' | tee -a /etc/fwupd/fwupd.conf;
		echo -e "${cyan}Disabling FWUPD's P2P Sharing...${coloroff}":
		echo -e 'P2pPolicy=off' | tee -a /etc/fwupd/fwupd.conf;

		echo -e "${cyan}Disabling FWUPD Telemetry...${coloroff}":
		sed -i 's/^ReportURI=.*/ReportURI=/' /etc/fwupd/remotes.d/lvfs.conf;
		sed -i 's/^ReportURI=.*/ReportURI=/' /etc/fwupd/remotes.d/lvfs-testing.conf;
		sed -i 's/^SecurityReportURI=.*/SecurityReportURI=/' /etc/fwupd/remotes.d/lvfs.conf;
		sed -i 's/^SecurityReportURI=.*/SecurityReportURI=/' /etc/fwupd/remotes.d/lvfs-testing.conf;
		sed -i 's/^AutomaticReports=.*/AutomaticReports=false/' /etc/fwupd/remotes.d/lvfs.conf;
		sed -i 's/^AutomaticReports=.*/AutomaticReports=false/' /etc/fwupd/remotes.d/lvfs-testing.conf;
		sed -i 's/^AutomaticSecurityReports=.*/AutomaticSecurityReports=false/' /etc/fwupd/remotes.d/lvfs.conf;
		sed -i 's/^AutomaticSecurityReports=.*/AutomaticSecurityReports=false/' /etc/fwupd/remotes.d/lvfs-testing.conf;

		if ! grep -q '^ReportURI=' /etc/fwupd/remotes.d/lvfs.conf; then
			echo -e 'ReportURI=' >> /etc/fwupd/remotes.d/lvfs.conf
		fi

		if ! grep -q '^ReportURI=' /etc/fwupd/remotes.d/lvfs-testing.conf; then
			echo -e 'ReportURI=' >> /etc/fwupd/remotes.d/lvfs-testing.conf
		fi

		if ! grep -q '^SecurityReportURI=' /etc/fwupd/remotes.d/lvfs.conf; then
			echo -e 'SecurityReportURI=' >> /etc/fwupd/remotes.d/lvfs.conf
		fi;

		if ! grep -q '^SecurityReportURI=' /etc/fwupd/remotes.d/lvfs-testing.conf; then
			echo -e 'SecurityReportURI=' >> /etc/fwupd/remotes.d/lvfs-testing.conf
		fi;

		if ! grep -q '^AutomaticReports=' /etc/fwupd/remotes.d/lvfs.conf; then
			echo -e 'AutomaticReports=false' >> /etc/fwupd/remotes.d/lvfs.conf
		fi

		if ! grep -q '^AutomaticReports=' /etc/fwupd/remotes.d/lvfs-testing.conf; then
			echo -e 'AutomaticReports=false' >> /etc/fwupd/remotes.d/lvfs-testing.conf
		fi

		if ! grep -q '^AutomaticSecurityReports=' /etc/fwupd/remotes.d/lvfs.conf; then
			echo -e 'AutomaticSecurityReports=false' >> /etc/fwupd/remotes.d/lvfs.conf
		fi

		if ! grep -q '^AutomaticSecurityReports=' /etc/fwupd/remotes.d/lvfs-testing.conf; then
			echo -e 'AutomaticSecurityReports=false' >> /etc/fwupd/remotes.d/lvfs-testing.conf
		fi

		systemctl restart fwupd;
		echo -e "Updating FWUPD...";
		fwupdmgr refresh --force;
		fwupdmgr upgrade;
	fi

	#Kernel Command Line
	if [ -x /usr/sbin/grubby ]; then
		echo -e "${cyan}Hardening Kernel...${coloroff}";
		echo -e "${yellow}This may take a moment....${coloroff}";

		#Memory Hardening
		#grubby --update-kernel=ALL --args="mem_encrypt=on"; #Enables SME on supported AMD platforms #XXX: can break boot, usually doesn't work but TSME in UEFI may
		#grubby --update-kernel=ALL --args="efi=disable_early_pci_dma"; #Prevents DMA during early bringup #XXX: can break boot
		grubby --update-kernel=ALL --args="init_on_alloc=1"; #Zero pages on allocation
		grubby --update-kernel=ALL --args="init_on_free=1"; #Zero pages on free
		grubby --update-kernel=ALL --args="page_alloc.shuffle=1"; #Randomize free lists
		grubby --update-kernel=ALL --args="pti=on kpti=on"; #Enable page table isolation
		grubby --update-kernel=ALL --args="randomize_kstack_offset=1"; #Randomize kernel stacks
		grubby --update-kernel=ALL --args="slab_nomerge"; #Don't merge same-size slabs
		#grubby --update-kernel=ALL --args="slub_debug=FZ"; #Enables SLUB sanity checks and red-zoning, #XXX: extreme performance impact and enables unhashed memory addresses

		#IOMMU Enablement
		grubby --update-kernel=ALL --args="iommu=force"; #???
		grubby --update-kernel=ALL --args="iommu.passthrough=0"; #Always use the IOMMU for DMA
		grubby --update-kernel=ALL --args="iommu.strict=1"; #Do not defer invalidation of hardware TLBs
		grubby --update-kernel=ALL --args="intel_iommu=on amd_iommu=force_isolation"; #Ensure the IOMMU driver is enabled

		#CPU Flaw Mitigations https://privsec.dev/posts/linux/desktop-linux-hardening/#cpu-mitigations
		grubby --update-kernel=ALL --args="mitigations=auto";
		grubby --update-kernel=ALL --args="spec_store_bypass_disable=on ssbd=force-on"; #Enables SSB mitigations, including all userspace processes
		grubby --update-kernel=ALL --args="spectre_v2=on spectre_bhi=on"; #Enable spectre_v2 mitigations, including all userspace processes
		grubby --update-kernel=ALL --args="tsx=off"; #Disable TSX
		grubby --update-kernel=ALL --args="kvm.nx_huge_pages=force";
		grubby --update-kernel=ALL --args="l1d_flush=on";
		grubby --update-kernel=ALL --args="spec_rstack_overflow=safe-ret";
		grubby --update-kernel=ALL --args="gather_data_sampling=force";
		grubby --update-kernel=ALL --args="reg_file_data_sampling=on";

		#Misc Hardening
		grubby --update-kernel=ALL --args="debugfs=off"; #Disable debugfs
		grubby --update-kernel=ALL --args="lockdown=confidentiality"; #Restrict userspace access to certain kernel features/attributes
		grubby --update-kernel=ALL --args="mce=0"; #Panic on uncorrectable errors #XXX: deprecated in 5.18
		grubby --update-kernel=ALL --args="module.sig_enforce=1"; #Block modules with invalid signatures #XXX: superceded by lockdown
		#grubby --update-kernel=ALL --args="oops=panic"; #Panic system on oops #XXX: can turn minor issues into annoyances
		grubby --update-kernel=ALL --args="vsyscall=none"; #Disable unnecessary legacy functionality
		#grubby --update-kernel=ALL --args="ia32_emulation=false"; #Disable support for 32-bit execution
		grubby --update-kernel=ALL --args="random.trust_cpu=off random.trust_bootloader=off"; #Entropy generation https://privsec.dev/posts/linux/desktop-linux-hardening/#entropy-generation

		#Nice to haves
		grubby --update-kernel=ALL --args="fsck.mode=force"; #FSCK mounts every boot, systemd default is once per 30 boots
		grubby --update-kernel=ALL --args="i8042.reset=1"; #Workaround buggy laptop keyboard/touchpads
		grubby --update-kernel=ALL --args="libata.allow_tpm=1"; #OPAL support
	fi;

	#Stronger Crypto
	if [ -x /usr/bin/update-crypto-policies ]; then
		echo -e "${cyan}Hardening crypto policies...${coloroff}";
		update-crypto-policies --set NEXT;
	fi

	#nullok https://networklogician.com/2021/04/11/disable-null-passwords/
	if [ -f /etc/fedora-release ]; then
		echo -e "${cyan}Disabling null/empty passwords...${coloroff}";
		/usr/bin/sed -i 's/\s+nullok//g' /etc/pam.d/system-auth;
	fi
	
	#Flatseal
	echo -e "${cyan}Installing Flatseal...${coloroff}";
	flatpak --user install com.github.tchx84.Flatseal;
	flatpak --user override com.github.tchx84.Flatseal --filesystem=/var/lib/flatpak/app:ro --filesystem=xdg-data/flatpak/app:ro --filesystem=xdg-data/flatpak/overrides:create;

	#hardened_malloc
	if [ -f /etc/fedora-release ]; then
		echo -e "${cyan}Installing & configuring hardened memory allocator...${coloroff}";
		dnf install hardened_malloc;
		flatpak override --system --filesystem=host-os:ro --env=LD_PRELOAD=/var/run/host/usr/lib64/libhardened_malloc.so;
		flatpak override --user --filesystem=host-os:ro --env=LD_PRELOAD=/var/run/host/usr/lib64/libhardened_malloc.so;
	fi

	#ClamAV
	if [ -f /etc/fedora-release ]; then
		echo -e "${cyan}Installing ClamAV...${coloroff}";
		dnf install clamav clamav-freshclam;
		freshclam;
	fi

	if [ -f /etc/fedora-release ]; then
		echo -e "${cyan}Installing firewall-config...${coloroff}";
		dnf install firewall-config;
	fi

	#Firejail
	if [ -f /etc/fedora-release ]; then
		echo -e "${cyan}Installing Firejail...${coloroff}";
		dnf install firejail;
		firecfg;
	fi

	#GPG
	if [ -f /etc/fedora-release ]; then
		echo -e "${cyan}Installing GnuPG...${coloroff}";
		dnf install gnupg2 pinentry;
	fi

	#real-ucode
	if [ -f /etc/fedora-release ]; then
		echo -e "${cyan}Installing latest microcodes...${coloroff}";
		dnf install real-ucode;
	fi

	#Dependencies
	if [ -f /etc/fedora-release ]; then
		echo -e "Installing various important dependencies...";
		dnf install wget curl;
		dnf install python3 python3-devel;
		dnf install kernel-devel kernel-headers;
		dnf install gcc glibc glibc-devel glibc-headers;
		dnf install libxcrypt-compat libcurl libcurl-devel mesa-libGLU --allowerasing; # Required for ex. DaVinci Resolve
		dnf install java-1.8.0-openjdk java-1.8.0-openjdk-devel java-11-openjdk java-11-openjdk-devel java-17-openjdk java-17-openjdk-devel java-21-openjdk java-21-openjdk-devel eclipse-jdt;
	fi

	#Services
	if [ -x /usr/bin/systemctl ]; then
		echo -e "${cyan}Disabling unnecessary services...${coloroff}";
		echo -e "${yellow}This may take a moment....${coloroff}";
		systemctl disable gssproxy.service --now; #Auth
		systemctl disable pcscd.service pcscd.socket --now; #Smartcards
		systemctl disable abrtd.service abrt-journal-core.service abrt-oops.service abrt-pstoreoops.service abrt-vmcore.service abrt-xorg.service --now; #ABRT
		systemctl disable atd.service --now; #At/Batch
		systemctl disable mcelog.service --now; #mcelog
		systemctl disable avahi-daemon.service avahi-daemon.socket --now; #Avahi
		systemctl disable ModemManager.service --now; #ModemManager
		systemctl disable iscsid.service iscsid.socket iscsi-init.service iscsi.service iscsiuio.service iscsiuio.socket --now; #iSCSI
		systemctl disable livesys.service livesys-late.service --now; #Anaconda leftovers
		systemctl disable multipathd.service multipathd.socket --now; #Multipath
		systemctl disable smartd.service --now; #smartd
		systemctl disable vboxservice.service --now; #VirtualBox
		systemctl disable vmtoolsd.service --now; #VMWare
		systemctl disable passim.service --now; #LAN P2P file sharing used by fwupd
	fi;

	# Debloat
	if [ -f /etc/fedora-release ]; then
		echo -e "Debloating...";
		echo -e "${yellow}This may take a moment....${coloroff}";
		dnf remove abrt dos2unix evince fedora-bookmarks fedora-chromium-config gnome-connections gnome-remote-desktop gnome-tour gvfs-smb ibus-typing-booster kpartx realmd samba-client sos 'sssd*' texlive-libs totem yelp;
	fi

	#HARMFUL PACKAGES
	if [ -f /etc/fedora-release ]; then
		echo -e "Removing dangerous/harmful packages...";
		echo -e "";
		dnf install remove-retired-packages;
		remove-retired-packages;
		echo -e "ClamTK: No longer maintained https://github.com/dave-theunsub/clamtk/issues/163";
		dnf remove clamtk;
		flatpak uninstall --system com.gitlab.davem.ClamTk;
		flatpak uninstall --user com.gitlab.davem.ClamTk;
		echo -e "Filezilla: Adware/Spying https://wikipedia.org/wiki/FileZilla#Bundled_adware_issues";
		dnf remove filezilla;
		flatpak uninstall --system org.filezillaproject.Filezilla;
		flatpak uninstall --user org.filezillaproject.Filezilla;
	fi

	#Flatpak Hardening
	if [ -x /usr/bin/flatpak ]; then
		echo -e "${red}Do you want to harden your Flatpaks (Recommended)?${coloroff}";
		echo -e "NOTE: You will likely need to set overrides for apps as needed via Flatseal or your DE if supported (Ex. KDE)";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					flatpak override --system --socket=wayland --nosocket=x11 --nosocket=fallback-x11 --nosocket=pulseaudio --nosocket=session-bus --nosocket=system-bus --unshare=network --unshare=ipc --disallow=bluetooth --nofilesystem=host:reset --nofilesystem=host-os --nofilesystem=host-etc --nofilesystem=home --nofilesystem=xdg-run/app/com.discordapp.Discord --nofilesystem=xdg-run/discord-ipc-0 --nofilesystem=xdg-videos --nofilesystem=xdg-desktop --nofilesystem=xdg-documents --nofilesystem=xdg-download --nofilesystem=xdg-pictures --nofilesystem=xdg-music --nodevice=input --nodevice=shm --nodevice=all --no-talk-name=org.freedesktop.Flatpak --no-talk-name=org.freedesktop.systemd1 --no-talk-name=ca.desrt.dconf --no-talk-name=org.gnome.Shell.Extensions --env=ELECTRON_OZONE_PLATFORM_HINT=auto;
					flatpak override --user --socket=wayland --nosocket=x11 --nosocket=fallback-x11 --nosocket=pulseaudio --nosocket=session-bus --nosocket=system-bus --unshare=network --unshare=ipc --disallow=bluetooth --nofilesystem=host:reset --nofilesystem=host-os --nofilesystem=host-etc --nofilesystem=home --nofilesystem=xdg-run/app/com.discordapp.Discord --nofilesystem=xdg-videos --nofilesystem=xdg-desktop --nofilesystem=xdg-documents --nofilesystem=xdg-download --nofilesystem=xdg-pictures --nofilesystem=xdg-music --nofilesystem=xdg-run/discord-ipc-0 --nodevice=input --nodevice=shm --nodevice=all --no-talk-name=org.freedesktop.Flatpak --no-talk-name=org.freedesktop.systemd1 --no-talk-name=ca.desrt.dconf --no-talk-name=org.gnome.Shell.Extensions --env=ELECTRON_OZONE_PLATFORM_HINT=auto;
					break;;
				No )
					break;;
			esac
		done
	fi;

	#Stealth Firewall
	if [ -x /usr/bin/firewall-cmd ]; then
		echo -e "${red}Do you want to harden your Firewall (Recommended)?${coloroff}";
		echo -e "NOTE: This will block incoming connections and isn't recommended for server environments";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					echo -e "${cyan}Hardening Firewall...${coloroff}";
					firewall-cmd --set-default-zone=drop;
					#firewall-cmd --add-protocol=icmp --permanent;
					firewall-cmd --add-protocol=ipv6-icmp --permanent;
					firewall-cmd --add-service=dhcpv6-client --permanent;
					firewall-cmd --reload;
					firewall-cmd --lockdown-on;
					break;;
				No )
					break;;
			esac
		done
	fi;

	#Hostname
	if [ -x /usr/bin/hostnamectl ]; then
		echo -e "${red}Would you like to set a generic hostname? (Recommended, especially for mobile devices)?${coloroff}";
		select yn in "Yes" "No"; do
		case $yn in
				Yes )
					echo -e "${cyan}Setting generic hostname...${coloroff}";
					nmcli general reload conf;
					hostnamectl set-hostname "localhost";
					hostnamectl --transient hostname '';
					nmcli general reload conf;
					break;;
				No )
					break;;
			esac
		done
	fi

	# More Debloating
	if [ -f /etc/fedora-release ]; then
		echo -e "${blue}Would you like to remove GNOME Calendar?${coloroff}";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove gnome-calendar;
					break;;
				No )
					echo -e "${red}Would you like to replace GNOME Calendar with the Flatpak? (Recommended)${coloroff}";
					select yn in "Yes" "No"; do
						case $yn in
								Yes )
									dnf remove gnome-calendar;
									flatpak --user install org.gnome.Calendar;
									break;;
								No )
									break;;
							esac
						done
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "${blue}Would you like to remove GNOME Camera?${coloroff}";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove snapshot;
					break;;
				No )
					echo -e "${red}Would you like to replace GNOME Camera with the Flatpak? (Recommended)${coloroff}";
					select yn in "Yes" "No"; do
						case $yn in
								Yes )
									dnf remove snapshot;
									flatpak --user install org.gnome.Snapshot;
									break;;
								No )
									break;;
							esac
						done
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to remove GNOME Contacts?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove gnome-contacts;
					break;;
				No )
					echo -e "Would you like to replace GNOME Contacts with the Flatpak? (Recommended)";
					select yn in "Yes" "No"; do
						case $yn in
								Yes )
									dnf remove gnome-contacts;
									flatpak --user install org.gnome.Contacts;
									break;;
								No )
									break;;
							esac
						done
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to remove GNOME Maps?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove gnome-maps;
					break;;
				No )
					echo -e "Would you like to replace GNOME Maps with the Flatpak? (Recommended)";
					select yn in "Yes" "No"; do
						case $yn in
								Yes )
									dnf remove gnome-maps;
									flatpak --user install org.gnome.Maps;
									flatpak override --user org.gnome.Maps --share=network;
									break;;
								No )
									break;;
							esac
						done
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to remove GNOME Weather?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove gnome-weather;
					break;;
				No )
					echo -e "Would you like to replace GNOME Weather with the Flatpak? (Recommended)";
					select yn in "Yes" "No"; do
						case $yn in
								Yes )
									dnf remove gnome-weather;
									flatpak --user install org.gnome.Weather;
									flatpak override --user org.gnome.Weather --share=network;
									break;;
								No )
									break;;
							esac
						done
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to remove Japanese Input Characters (Anthy)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove '*anthy*';
					break;;
				No )
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to remove Korean Input Characters (Hangul)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove '*hangul*';
					break;;
				No )
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to remove Mandarin Input Characters (Pinyin)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove '*pinyin*';
					break;;
				No )
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to remove Chinese Input Characters (Zhuyin)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove '*zhuyin*';
					break;;
				No )
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to remove Multilingual Input (M17n)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove '*m17n*';
					break;;
				No )
					break;;
			esac
		done
	fi;

	# Replacing built-in apps with Flatpaks
	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to replace GNOME Calculator with the Flatpak (Recommended)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove gnome-calculator;
					flatpak --user install org.gnome.Calculator;
					break;;
				No )
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to replace GNOME Clocks with the Flatpak (Recommended)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove gnome-clocks;
					flatpak --user install org.gnome.clocks;
					break;;
				No )
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to replace GNOME Disk Usage Analyzer with the Flatpak (Recommended)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove baobab;
					flatpak --user install org.gnome.baobab;
					break;;
				No )
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to replace GNOME Document Scanner with the Flatpak (Recommended)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove simple-scan;
					flatpak --user install org.gnome.SimpleScan;
					break;;
				No )
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to replace GNOME Font Viewer with the Flatpak (Recommended)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove gnome-font-viewer;
					flatpak --user install org.gnome.font-viewer;
					break;;
				No )
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to replace GNOME Image Viewer with the Flatpak (Recommended)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove loupe;
					flatpak --user install org.gnome.Loupe;
					break;;
				No )
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to replace Fedora Media Writer with the Flatpak (Recommended)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove mediawriter;
					flatpak --user install org.fedoraproject.MediaWriter;
					flatpak --user override org.fedoraproject.MediaWriter --share=network;
					break;;
				No )
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to replace LibreOffice with the Flatpak (Recommended)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					dnf remove libreoffice-core;
					flatpak --user install org.libreoffice.LibreOffice;
					break;;
				No )
					break;;
			esac
		done
	fi;

	#Codecs
	if [ -f /etc/fedora-release ]; then
		echo -e "Would you like to install codecs & dependencies for media playback? (Recommended)?";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					echo -e "Installing codecs...";
					dnf group install multimedia --with-optional --setopt="install_weak_deps=False" --exclude=PackageKit-gstreamer-plugin;
					dnf group install sound-and-video;
					dnf swap ffmpeg-free ffmpeg --allowerasing;
					dnf swap fdk-aac-free fdk-aac --allowerasing;
					dnf swap libavcodec libavcodec-freeworld --allowerasing;
					dnf install libheif libheif-freeworld --allowerasing;
					dnf install gstreamer1-plugins-{bad-\*,good-\*,base} gstreamer1-libav --exclude=gstreamer1-plugins-bad-free-devel;
					dnf install lame\* --exclude=lame-devel;
					dnf config-manager setopt fedora-cisco-openh264.enabled=1;
					dnf update --refresh;
					dnf install gstreamer1-plugin-openh264 mozilla-openh264;
					flatpak --user install org.freedesktop.Platform.openh264;
					dnf install install clinfo mesa-libOpenCL pocl;
					dnf install mesa-dri-drivers mesa-va-drivers libva libva-utils;
					dnf install vdpauinfo libvdpau libvdpau-va-gl libdvdcss;
					dnf install yt-dlp;
					break;;
				No )
					break;;
			esac
		done
	fi;

	if [ -f /etc/fedora-release ]; then
		echo -e "Do you want to harden Firefox with Phoenix? https://phoenix.celenity.dev (Recommended)";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					bash -c "$(curl -fsSL https://phoenix.celenity.dev/fedora_install.sh)";
					break;;
				No )
					break;;
			esac
		done
	fi

	if [ -f /etc/fedora-release ]; then
		echo -e "Do you want to harden Thunderbird with Dove? https://dove.celenity.dev (Recommended)";
		select yn in "Yes" "No"; do
			case $yn in
				Yes )
					bash -c "$(curl -fsSL https://dove.celenity.dev/fedora_install.sh)";
					break;;
				No )
					break;;
			esac
		done
	fi

	#Clean-up
	if [ -f /etc/fedora-release ]; then
		echo -e "${red}Cleaning up DNF...${coloroff}";
		dnf autoremove;
		dnf clean all;

		echo -e "${red}Updating DNF Cache...${coloroff}";
		dnf update --refresh;

		echo -e "${red}Updating Flatpak Cache...${coloroff}";
		flatpak --system update;
		flatpak --user update;

		echo -e "${red}Updating Firejail...${coloroff}";
		firecfg;
	fi;

	echo -e "Done! :) Now make sure to run slingshot again - this time without sudo, for additional options and configurations.";
else
	#Looks
	if [ -d "/usr/share/fonts/adobe-source-code-pro" ]; then
		gsettings set org.gnome.builder.editor font-name 'Source Code Pro 10';
		gsettings set org.gnome.desktop.interface monospace-font-name 'Source Code Pro 10';
		gsettings set org.mate.desktop.interface monospace-font-name 'Source Code Pro 10';
	fi;
	if [ -f "/usr/share/fonts/mozilla-fira/FiraSans-Regular.otf" ] || [ -f "/usr/share/fonts/TTF/FiraSans-Regular.ttf" ]; then
		gsettings set org.gnome.desktop.interface font-name 'Fira Sans 10';
		gsettings set org.gnome.desktop.wm.preferences titlebar-font 'Fira Sans Bold 11';
		gsettings set org.cinnamon.desktop.interface font-name 'Fira Sans 10';
		#TODO cinnamon legacy title font
		gsettings set org.mate.caja.desktop font 'Fira Sans 10';
		gsettings set org.mate.desktop.interface font-name 'Fira Sans 10';
		gsettings set org.mate.marco.general titlebar-font 'Fira Sans Bold 11';
	fi;
	if [ -f "/usr/share/fonts/mozilla-fira/FiraMono-Regular.otf" ] || [ -f "/usr/share/fonts/TTF/FiraMono-Regular.ttf" ]; then
		gsettings set org.gnome.builder.editor font-name 'Fira Mono 10';
		gsettings set org.gnome.desktop.interface monospace-font-name 'Fira Mono 10';
		gsettings set org.gnome.gedit.preferences.editor editor-font 'Fira Mono 10';
		gsettings set org.cinnamon.desktop.interface monospace-font-name 'Fira Mono 10';
		gsettings set org.mate.desktop.interface monospace-font-name 'Fira Mono 10';
	fi;
	if [ -d "/usr/share/icons/Numix-Circle" ]; then
		gsettings set org.gnome.desktop.interface icon-theme 'Numix-Circle';
		gsettings set org.cinnamon.desktop.interface icon-theme 'Numix-Circle';
		gsettings set org.mate.desktop.interface icon-theme 'Numix-Circle';
	fi;

	#Night Light
	echo -e "${cyan}Do you want to enable GNOME Night Light?${coloroff}";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				gsettings set org.gnome.settings-daemon.plugins.color night-light-enabled true;
				break;;
			No )
				gsettings set org.gnome.settings-daemon.plugins.color night-light-enabled false;
				break;;
		esac
	done

	#Power #TODO: MATE
	echo -e "Do you want to enable auto suspend?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type 'suspend';
				gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'suspend';
				break;;
			No )
				gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type 'nothing';
				gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'nothing';
				break;;
		esac
	done

	#Search
	echo -e "Do you want to enable GNOME Search Providers? (https://developer.gnome.org/documentation/tutorials/search-provider.html)";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				gsettings set org.gnome.desktop.search-providers disable-external false;
				break;;
			No )
				gsettings set org.gnome.desktop.search-providers disable-external true;
				break;;
		esac
	done
	echo -e "Do you want to enable File Indexing?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				gsettings set org.freedesktop.Tracker3.Miner.Files enable-monitors true;
				gsettings set org.freedesktop.Tracker3.Miner.Files crawling-interval -1;
				systemctl unmask --user --now tracker-miner-fs-3.service || true;
				break;;
			No )
				gsettings set org.freedesktop.Tracker3.Miner.Files enable-monitors false;
				gsettings set org.freedesktop.Tracker3.Miner.Files crawling-interval -2;
				systemctl mask --user --now tracker-miner-fs-3.service || true;
				tracker3 reset -s || true;
				break;;
		esac
	done

	#Themes
	echo -e "Do you want to enable dark mode?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark';
				gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark';
				gsettings set org.cinnamon.theme name 'Mint-Y-Dark';
				gsettings set org.cinnamon.desktop.interface gtk-theme 'Mint-Y-Dark';
				gsettings set org.cinnamon.desktop.wm.preferences theme 'Mint-Y-Dark';
				gsettings set org.mate.desktop.interface gtk-theme 'BlackMATE';
				gsettings set org.mate.marco.general theme 'BlackMATE';
				break;;
			No )
				gsettings set org.gnome.desktop.interface color-scheme 'default';
				gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita';
				gsettings set org.cinnamon.theme name 'Mint-Y';
				gsettings set org.cinnamon.desktop.interface gtk-theme 'Mint-Y';
				gsettings set org.cinnamon.desktop.wm.preferences theme 'Mint-Y';
				gsettings set org.mate.desktop.interface gtk-theme 'BlueMenta';
				gsettings set org.mate.marco.general theme 'BlueMenta';
				break;;
		esac
	done
fi;

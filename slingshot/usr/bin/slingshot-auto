#it under the terms of the GNU Affero General Public License as published by
#the Free Software Foundation, either version 3 of the License, or
#(at your option) any later version.
#
#This program is distributed in the hope that it will be useful,
#but WITHOUT ANY WARRANTY; without even the implied warranty of
#MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#GNU Affero General Public License for more details.
#
#You should have received a copy of the GNU Affero General Public License
#along with this program.  If not, see <https://www.gnu.org/licenses/>.

coloroff='\e[0m';
black='\e[0;30m';
blue='\e[0;34m';
cyan='\e[0;36m';
green='\e[0;32m';
purple='\e[0;35m';
red='\e[0;31m';
white='\e[0;37m';
yellow='\e[0;33m';

if [ "$(/usr/bin/id -u)" -eq "0" ]; then
	if [ -f "/usr/lib/systemd/system/zram-swap.service" ]; then
		echo "Enabling zram-swap";
		systemctl enable zram-swap.service --now; #XXX: replaced by systemd-zram-generator
	fi;

	if [ -f "/usr/lib/systemd/system/fstrim.timer" ]; then
		echo "Enabling weekly fstrim";
		systemctl enable fstrim.timer --now;
	fi

	#Repos
	if [ -f /etc/fedora-release ] || [ -f /etc/centos-release ]; then
		echo "${cyan}Enabling RPM Fusion, Divested RPM, & replacing system Flathub with user Flathub...${coloroff}";
		echo "${red}Please verify the RPM Fusion signing keys from here: https://rpmfusion.org/keys${coloroff}";
		echo "Free - F33-41: ${yellow}E9A4 91A3 DE24 7814 E7E0 67EA E06F 8ECD D651 FF2E${coloroff}";
		echo "Free - EL9: ${yellow}EDC0 0FE7 418C 9DF7 EF49  91A4 7403 EA33 2964 58F3${coloroff}";
		echo "Free - EL8: ${yellow}8379 35CD 19E1 23AA 7F8A  8E69 979F 0C69 158B 3811${coloroff}";
		echo "Free - EL7: ${yellow}DB9A 9A57 CAFD 23DA 3A88  792F 758B 3D18 F5CF 6C1E${coloroff}";
		echo "Nonfree - ${yellow}F33-41: 79BD B88F 9BBF 7391 0FD4 095B 6A2A F961 9484 3C65${coloroff}";
		echo "Nonfree - ${yellow}EL9: BB24 128A 4BB3 C335 2C0B  75A2 E417 4E6B AAB2 12EA${coloroff}";
		echo "Nonfree - ${yellow}EL8: CF9F D59F 61D6 6121 46CD AC8E 14B6 792D BDDA 8475${coloroff}";
		echo "Nonfree - ${yellow}EL7: C3FA F3A9 6B39 8583 91ED  D8D9 C8F7 6DF1 A310 8F6C${coloroff}";
	fi

	if [ -f /etc/fedora-release ]; then

		echo "${red}Cleaning up DNF...${coloroff}";
		dnf autoremove;
		dnf clean all;

		echo "${red}Updating DNF Cache...${coloroff}";
		dnf update --refresh -y;
		
		dnf remove fedora-third-party fedora-workstation-repositories -y;
		dnf install "https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" -y;
		dnf install "https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm" -y;
		dnf install rpmfusion-free-release-tainted -y;
		dnf install rpmfusion-nonfree-release-tainted -y;
		wget https://gitlab.com/divested/divested-release/-/jobs/7046900191/artifacts/raw/build/noarch/divested-release-20240607-1.noarch.rpm;
		dnf install divested-release-20240607-1.noarch.rpm -y;
		dnf remove fedora-flathub-remote -y;

		echo "${red}Updating DNF Cache...${coloroff}";
		dnf update --refresh -y;

		echo "${red}Updating Flatpak Cache...${coloroff}";
		flatpak --system update -y;
		flatpak --user update -y;

		flatpak remote-delete --system fedora;
		flatpak remote-delete --system flathub;
		flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo;

		echo "${red}Updating Flatpak Cache...${coloroff}";
		flatpak --system update -y;
		flatpak --user update -y;

		echo "${red}Cleaning up DNF...${coloroff}";
		dnf autoremove;
		dnf clean all;

	elif [ -f /etc/centos-release ]; then
		yum install epel-release;
		yum localinstall --nogpgcheck "https://download1.rpmfusion.org/free/el/rpmfusion-free-release-$(rpm -E %centos).noarch.rpm";
		yum localinstall --nogpgcheck "https://download1.rpmfusion.org/nonfree/el/rpmfusion-nonfree-release-$(rpm -E %centos).noarch.rpm";
	fi

	if [ -d "/etc/yum.repos.d" ]; then
		echo "${cyan}Setting DNF repos to use HTTPS...${coloroff}";
		sed -i 's/metalink?repo=/metalink\?protocol\=https\&repo\=/' /etc/yum.repos.d/*.repo;

		echo "Remember: This will need to be done again if any of them are updated!";

		echo "${cyan}Disabling DNF countme...${coloroff}";
		sed -i 's/countme=1/countme=0/' /etc/yum.repos.d/*.repo;
		sed -i '$a countme=False' /etc/dnf/dnf.conf;

		echo "Speeding up DNF...";
		sed -i '$a max_parallel_downloads=10' /etc/dnf/dnf.conf;
	fi

	#FWUPD
	if [ -x /usr/bin/fwupdmgr ]; then
		echo "${cyan}Setting FWUPD to use HTTPS...${coloroff}":
		echo 'UriSchemes=file;https' | tee -a /etc/fwupd/fwupd.conf;
		echo "${cyan}Disabling FWUPD's P2P Sharing...${coloroff}":
		echo 'P2pPolicy=off' | tee -a /etc/fwupd/fwupd.conf;

		echo "${cyan}Disabling FWUPD Telemetry...${coloroff}":
		sed -i 's/^ReportURI=.*/ReportURI=/' /etc/fwupd/remotes.d/lvfs.conf;
		sed -i 's/^ReportURI=.*/ReportURI=/' /etc/fwupd/remotes.d/lvfs-testing.conf;
		sed -i 's/^SecurityReportURI=.*/SecurityReportURI=/' /etc/fwupd/remotes.d/lvfs.conf;
		sed -i 's/^SecurityReportURI=.*/SecurityReportURI=/' /etc/fwupd/remotes.d/lvfs-testing.conf;
		sed -i 's/^AutomaticReports=.*/AutomaticReports=false/' /etc/fwupd/remotes.d/lvfs.conf;
		sed -i 's/^AutomaticReports=.*/AutomaticReports=false/' /etc/fwupd/remotes.d/lvfs-testing.conf;
		sed -i 's/^AutomaticSecurityReports=.*/AutomaticSecurityReports=false/' /etc/fwupd/remotes.d/lvfs.conf;
		sed -i 's/^AutomaticSecurityReports=.*/AutomaticSecurityReports=false/' /etc/fwupd/remotes.d/lvfs-testing.conf;

		if ! grep -q '^ReportURI=' /etc/fwupd/remotes.d/lvfs.conf; then
			echo 'ReportURI=' >> /etc/fwupd/remotes.d/lvfs.conf
		fi

		if ! grep -q '^ReportURI=' /etc/fwupd/remotes.d/lvfs-testing.conf; then
			echo 'ReportURI=' >> /etc/fwupd/remotes.d/lvfs-testing.conf
		fi

		if ! grep -q '^SecurityReportURI=' /etc/fwupd/remotes.d/lvfs.conf; then
			echo 'SecurityReportURI=' >> /etc/fwupd/remotes.d/lvfs.conf
		fi;

		if ! grep -q '^SecurityReportURI=' /etc/fwupd/remotes.d/lvfs-testing.conf; then
			echo 'SecurityReportURI=' >> /etc/fwupd/remotes.d/lvfs-testing.conf
		fi;

		if ! grep -q '^AutomaticReports=' /etc/fwupd/remotes.d/lvfs.conf; then
			echo 'AutomaticReports=false' >> /etc/fwupd/remotes.d/lvfs.conf
		fi

		if ! grep -q '^AutomaticReports=' /etc/fwupd/remotes.d/lvfs-testing.conf; then
			echo 'AutomaticReports=false' >> /etc/fwupd/remotes.d/lvfs-testing.conf
		fi

		if ! grep -q '^AutomaticSecurityReports=' /etc/fwupd/remotes.d/lvfs.conf; then
			echo 'AutomaticSecurityReports=false' >> /etc/fwupd/remotes.d/lvfs.conf
		fi

		if ! grep -q '^AutomaticSecurityReports=' /etc/fwupd/remotes.d/lvfs-testing.conf; then
			echo 'AutomaticSecurityReports=false' >> /etc/fwupd/remotes.d/lvfs-testing.conf
		fi

		systemctl restart fwupd;
		echo "Updating FWUPD...";
		fwupdmgr refresh --force;
		fwupdmgr upgrade;
	fi

	#Kernel Command Line
	if [ -x /usr/sbin/grubby ]; then
		echo "${cyan}Hardening Kernel...${coloroff}";
		echo "${yellow}This may take a moment....${coloroff}";

		#Memory Hardening
		#grubby --update-kernel=ALL --args="mem_encrypt=on"; #Enables SME on supported AMD platforms #XXX: can break boot, usually doesn't work but TSME in UEFI may
		#grubby --update-kernel=ALL --args="efi=disable_early_pci_dma"; #Prevents DMA during early bringup #XXX: can break boot
		grubby --update-kernel=ALL --args="init_on_alloc=1"; #Zero pages on allocation
		grubby --update-kernel=ALL --args="init_on_free=1"; #Zero pages on free
		grubby --update-kernel=ALL --args="page_alloc.shuffle=1"; #Randomize free lists
		grubby --update-kernel=ALL --args="pti=on kpti=on"; #Enable page table isolation
		grubby --update-kernel=ALL --args="randomize_kstack_offset=1"; #Randomize kernel stacks
		grubby --update-kernel=ALL --args="slab_nomerge"; #Don't merge same-size slabs
		#grubby --update-kernel=ALL --args="slub_debug=FZ"; #Enables SLUB sanity checks and red-zoning, #XXX: extreme performance impact and enables unhashed memory addresses

		#IOMMU Enablement
		grubby --update-kernel=ALL --args="iommu=force"; #???
		grubby --update-kernel=ALL --args="iommu.passthrough=0"; #Always use the IOMMU for DMA
		grubby --update-kernel=ALL --args="iommu.strict=1"; #Do not defer invalidation of hardware TLBs
		grubby --update-kernel=ALL --args="intel_iommu=on amd_iommu=force_isolation"; #Ensure the IOMMU driver is enabled

		#CPU Flaw Mitigations https://privsec.dev/posts/linux/desktop-linux-hardening/#cpu-mitigations
		grubby --update-kernel=ALL --args="mitigations=auto";
		grubby --update-kernel=ALL --args="spec_store_bypass_disable=on ssbd=force-on"; #Enables SSB mitigations, including all userspace processes
		grubby --update-kernel=ALL --args="spectre_v2=on spectre_bhi=on"; #Enable spectre_v2 mitigations, including all userspace processes
		grubby --update-kernel=ALL --args="tsx=off"; #Disable TSX
		grubby --update-kernel=ALL --args="kvm.nx_huge_pages=force";
		grubby --update-kernel=ALL --args="l1d_flush=on";
		grubby --update-kernel=ALL --args="spec_rstack_overflow=safe-ret";
		grubby --update-kernel=ALL --args="gather_data_sampling=force";
		grubby --update-kernel=ALL --args="reg_file_data_sampling=on";

		#Misc Hardening
		grubby --update-kernel=ALL --args="debugfs=off"; #Disable debugfs
		grubby --update-kernel=ALL --args="lockdown=confidentiality"; #Restrict userspace access to certain kernel features/attributes
		grubby --update-kernel=ALL --args="mce=0"; #Panic on uncorrectable errors #XXX: deprecated in 5.18
		grubby --update-kernel=ALL --args="module.sig_enforce=1"; #Block modules with invalid signatures #XXX: superceded by lockdown
		#grubby --update-kernel=ALL --args="oops=panic"; #Panic system on oops #XXX: can turn minor issues into annoyances
		grubby --update-kernel=ALL --args="vsyscall=none"; #Disable unnecessary legacy functionality
		#grubby --update-kernel=ALL --args="ia32_emulation=false"; #Disable support for 32-bit execution
		grubby --update-kernel=ALL --args="random.trust_cpu=off random.trust_bootloader=off"; #Entropy generation https://privsec.dev/posts/linux/desktop-linux-hardening/#entropy-generation

		#Nice to haves
		grubby --update-kernel=ALL --args="fsck.mode=force"; #FSCK mounts every boot, systemd default is once per 30 boots
		grubby --update-kernel=ALL --args="i8042.reset=1"; #Workaround buggy laptop keyboard/touchpads
		grubby --update-kernel=ALL --args="libata.allow_tpm=1"; #OPAL support
	fi;

	#Stronger Crypto
	if [ -x /usr/bin/update-crypto-policies ]; then
		echo "${cyan}Hardening crypto policies...${coloroff}";
		update-crypto-policies --set NEXT;
	fi

	#nullok https://networklogician.com/2021/04/11/disable-null-passwords/
	if [ -f /etc/fedora-release ]; then
		echo "${cyan}Disabling null/empty passwords...${coloroff}";
		/usr/bin/sed -i 's/\s+nullok//g' /etc/pam.d/system-auth;
	fi

	#Flatseal
	echo "${cyan}Installing Flatseal...${coloroff}";
	flatpak --user install com.github.tchx84.Flatseal -y;
	flatpak --user override com.github.tchx84.Flatseal --filesystem=/var/lib/flatpak/app:ro --filesystem=xdg-data/flatpak/app:ro --filesystem=xdg-data/flatpak/overrides:create;

	#hardened_malloc
	if [ -f /etc/fedora-release ]; then
		echo "${cyan}Installing & configuring hardened memory allocator...${coloroff}";
		dnf install hardened_malloc -y;
		flatpak override --system --filesystem=host-os:ro --env=LD_PRELOAD=/var/run/host/usr/lib64/libhardened_malloc.so -y;
		flatpak override --user --filesystem=host-os:ro --env=LD_PRELOAD=/var/run/host/usr/lib64/libhardened_malloc.so -y;
	fi

	#ClamAV
	if [ -f /etc/fedora-release ]; then
		echo "${cyan}Installing ClamAV...${coloroff}";
		dnf install clamav clamav-freshclam -y;
		freshclam;
	fi
	
	if [ -f /etc/fedora-release ]; then
		echo "${cyan}Installing firewall-config...${coloroff}";
		dnf install firewall-config -y;
	fi

	#Firejail
	if [ -f /etc/fedora-release ]; then
		echo "${cyan}Installing Firejail...${coloroff}";
		dnf install firejail -y;
		firecfg;
	fi

	#GPG
	if [ -f /etc/fedora-release ]; then
		echo "${cyan}Installing GnuPG...${coloroff}";
		dnf install gnupg2 pinentry -y;
	fi

	#real-ucode
	if [ -f /etc/fedora-release ]; then
		echo "${cyan}Installing latest microcodes...${coloroff}";
		dnf install real-ucode -y;
	fi

	#Dependencies
	if [ -f /etc/fedora-release ]; then
		echo "Installing various important dependencies...";
		dnf install wget curl -y;
		dnf install python3 python3-devel -y;
		dnf install kernel-devel kernel-headers -y;
		dnf install gcc glibc glibc-devel glibc-headers -y;
		dnf install libxcrypt-compat libcurl libcurl-devel mesa-libGLU --allowerasing -y; # Required for ex. DaVinci Resolve
		dnf install java-1.8.0-openjdk java-1.8.0-openjdk-devel java-11-openjdk java-11-openjdk-devel java-17-openjdk java-17-openjdk-devel java-21-openjdk java-21-openjdk-devel eclipse-jdt -y;
	fi

	#Services
	if [ -x /usr/bin/systemctl ]; then
		echo "${cyan}Disabling unnecessary services...${coloroff}";
		echo "${yellow}This may take a moment....${coloroff}";
		systemctl disable gssproxy.service --now; #Auth
		systemctl disable pcscd.service pcscd.socket --now; #Smartcards
		systemctl disable abrtd.service abrt-journal-core.service abrt-oops.service abrt-pstoreoops.service abrt-vmcore.service abrt-xorg.service --now; #ABRT
		systemctl disable atd.service --now; #At/Batch
		systemctl disable mcelog.service --now; #mcelog
		systemctl disable avahi-daemon.service avahi-daemon.socket --now; #Avahi
		systemctl disable ModemManager.service --now; #ModemManager
		systemctl disable iscsid.service iscsid.socket iscsi-init.service iscsi.service iscsiuio.service iscsiuio.socket --now; #iSCSI
		systemctl disable livesys.service livesys-late.service --now; #Anaconda leftovers
		systemctl disable multipathd.service multipathd.socket --now; #Multipath
		systemctl disable smartd.service --now; #smartd
		systemctl disable vboxservice.service --now; #VirtualBox
		systemctl disable vmtoolsd.service --now; #VMWare
		systemctl disable passim.service --now; #LAN P2P file sharing used by fwupd
	fi;

	# Debloat
	if [ -f /etc/fedora-release ]; then
		echo "Debloating...";
		echo "${yellow}This may take a moment....${coloroff}";
		dnf remove abrt dos2unix evince fedora-bookmarks fedora-chromium-config gnome-connections gnome-remote-desktop gnome-tour gvfs-smb ibus-typing-booster kpartx realmd samba-client sos 'sssd*' texlive-libs totem yelp -y;
	fi

	#Flatpak Hardening
	flatpak override --system --socket=wayland --nosocket=x11 --nosocket=fallback-x11 --nosocket=pulseaudio --nosocket=session-bus --nosocket=system-bus --unshare=network --unshare=ipc --nofilesystem=host:reset --nofilesystem=host-os --nofilesystem=host-etc --nofilesystem=home --nofilesystem=xdg-run/app/com.discordapp.Discord --nodevice=input --nodevice=shm --nodevice=all --no-talk-name=org.freedesktop.Flatpak --no-talk-name=org.freedesktop.systemd1 --no-talk-name=ca.desrt.dconf --no-talk-name=org.gnome.Shell.Extensions;
	flatpak override --user --socket=wayland --nosocket=x11 --nosocket=fallback-x11 --nosocket=pulseaudio --nosocket=session-bus --nosocket=system-bus --unshare=network --unshare=ipc --nofilesystem=host:reset --nofilesystem=host-os --nofilesystem=host-etc --nofilesystem=home --nofilesystem=xdg-run/app/com.discordapp.Discord --nodevice=input --nodevice=shm --nodevice=all --no-talk-name=org.freedesktop.Flatpak --no-talk-name=org.freedesktop.systemd1 --no-talk-name=ca.desrt.dconf --no-talk-name=org.gnome.Shell.Extensions;

	#Stealth Firewall
	if [ -x /usr/bin/firewall-cmd ]; then
		echo "${cyan}Hardening Firewall...${coloroff}";
		firewall-cmd --set-default-zone=drop;
		#firewall-cmd --add-protocol=icmp --permanent;
		firewall-cmd --add-protocol=ipv6-icmp --permanent;
		firewall-cmd --add-service=dhcpv6-client --permanent;
		firewall-cmd --reload;
		firewall-cmd --lockdown-on;
	fi

	#Hostname
	if [ -x /usr/bin/hostnamectl ]; then
		echo "${cyan}Setting generic hostname...${coloroff}";
		nmcli general reload conf;
		hostnamectl set-hostname "localhost";
		hostnamectl --transient hostname '';
		nmcli general reload conf;
	fi

	# More Debloating
	if [ -f /etc/fedora-release ]; then
		echo "${red}Removing GNOME Calendar...${coloroff}";
		dnf remove gnome-calendar -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "${red}Removing GNOME Camera...${coloroff}";
		dnf remove snapshot -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Removing GNOME Contacts...";
		dnf remove gnome-contacts -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Removing GNOME Maps...";
		dnf remove gnome-maps -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Removing GNOME Weather...";
		dnf remove gnome-weather -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Removing Japanese Input Characters (Anthy)...";
		dnf remove '*anthy*' -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Removing Korean Input Characters (Hangul)...";
		dnf remove '*hangul*' -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Removing Mandarin Input Characters (Pinyin)...";
		dnf remove '*pinyin*' -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Removing Chinese Input Characters (Zhuyin)...";
		dnf remove '*zhuyin*' -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Removing Multilingual Input (M17n)...";
		dnf remove '*m17n*' -y;
	fi

	# Replacing built-in apps with Flatpaks
	if [ -f /etc/fedora-release ]; then
		echo "Replacing GNOME Calculator with Flatpak...";
		dnf remove gnome-calculator -y;
		flatpak --user install org.gnome.Calculator -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Replacing GNOME Clocks with Flatpak...";
		dnf remove gnome-clocks -y;
		flatpak --user install org.gnome.clocks -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Replacing GNOME Disk Usage Analyzer with Flatpak...";
		dnf remove baobab -y;
		flatpak --user install org.gnome.baobab -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Replacing GNOME Document Scanner with Flatpak...";
		dnf remove simple-scan -y;
		flatpak --user install org.gnome.SimpleScan -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Replacing GNOME Font Viewer with Flatpak...";
		dnf remove gnome-font-viewer -y;
		flatpak --user install org.gnome.font-viewer -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Replacing GNOME Image Viewer with Flatpak...";
		dnf remove loupe -y;
		flatpak --user install org.gnome.Loupe -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Replacing Fedora Media Writer with Flatpak...";
		dnf remove mediawriter -y;
		flatpak --user install org.fedoraproject.MediaWriter -y;
		flatpak --user override org.fedoraproject.MediaWriter --share=network;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Replacing LibreOffice with Flatpak...";
		dnf remove libreoffice-core -y;
		flatpak --user install org.libreoffice.LibreOffice -y;
	fi

	#Codecs
	if [ -f /etc/fedora-release ]; then
		echo "Installing codecs...";
		dnf group install multimedia --with-optional --setopt="install_weak_deps=False" --exclude=PackageKit-gstreamer-plugin -y;
		dnf group install sound-and-video -y;
		dnf swap ffmpeg-free ffmpeg --allowerasing -y;
		dnf swap fdk-aac-free fdk-aac --allowerasing -y;
		dnf swap libavcodec libavcodec-freeworld --allowerasing -y;
		dnf install libheif libheif-freeworld --allowerasing -y;
		dnf install gstreamer1-plugins-{bad-\*,good-\*,base} gstreamer1-libav --exclude=gstreamer1-plugins-bad-free-devel -y;
		dnf install lame\* --exclude=lame-devel -y;
		dnf config-manager setopt fedora-cisco-openh264.enabled=1 -y;
		dnf update --refresh -y;
		dnf install gstreamer1-plugin-openh264 mozilla-openh264 -y;
		flatpak --user install org.freedesktop.Platform.openh264 -y;
		dnf install install clinfo mesa-libOpenCL pocl -y;
		dnf install mesa-dri-drivers mesa-va-drivers libva libva-utils -y;
		dnf install vdpauinfo libvdpau libvdpau-va-gl libdvdcss -y;
		dnf install yt-dlp -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Installing Firefox...";
		dnf install firefox -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Hardening Firefox with Phoenix...";
		bash -c "$(curl -fsSL https://phoenix.celenity.dev/fedora_install.sh)";
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Installing Thunderbird...";
		dnf install thunderbird -y;
	fi

	if [ -f /etc/fedora-release ]; then
		echo "Hardening Thunderbird with Dove...";
		bash -c "$(curl -fsSL https://dove.celenity.dev/fedora_install.sh)";
	fi

	#Clean-up
	if [ -f /etc/fedora-release ]; then
		echo "${red}Cleaning up DNF...${coloroff}";
		dnf autoremove;
		dnf clean all;

		echo "${red}Updating DNF Cache...${coloroff}";
		dnf update --refresh;

		echo "${red}Updating Flatpak Cache...${coloroff}";
		flatpak --system update;
		flatpak --user update;

		echo "${red}Updating Firejail...${coloroff}";
		firecfg;
	fi;

	echo "Done! :) Now make sure to run slingshot again - this time without sudo, for additional options and configurations.";
else
	#Looks
	if [ -d "/usr/share/fonts/adobe-source-code-pro" ]; then
		gsettings set org.gnome.builder.editor font-name 'Source Code Pro 10';
		gsettings set org.gnome.desktop.interface monospace-font-name 'Source Code Pro 10';
		gsettings set org.mate.desktop.interface monospace-font-name 'Source Code Pro 10';
	fi;
	if [ -f "/usr/share/fonts/mozilla-fira/FiraSans-Regular.otf" ] || [ -f "/usr/share/fonts/TTF/FiraSans-Regular.ttf" ]; then
		gsettings set org.gnome.desktop.interface font-name 'Fira Sans 10';
		gsettings set org.gnome.desktop.wm.preferences titlebar-font 'Fira Sans Bold 11';
		gsettings set org.cinnamon.desktop.interface font-name 'Fira Sans 10';
		#TODO cinnamon legacy title font
		gsettings set org.mate.caja.desktop font 'Fira Sans 10';
		gsettings set org.mate.desktop.interface font-name 'Fira Sans 10';
		gsettings set org.mate.marco.general titlebar-font 'Fira Sans Bold 11';
	fi;
	if [ -f "/usr/share/fonts/mozilla-fira/FiraMono-Regular.otf" ] || [ -f "/usr/share/fonts/TTF/FiraMono-Regular.ttf" ]; then
		gsettings set org.gnome.builder.editor font-name 'Fira Mono 10';
		gsettings set org.gnome.desktop.interface monospace-font-name 'Fira Mono 10';
		gsettings set org.gnome.gedit.preferences.editor editor-font 'Fira Mono 10';
		gsettings set org.cinnamon.desktop.interface monospace-font-name 'Fira Mono 10';
		gsettings set org.mate.desktop.interface monospace-font-name 'Fira Mono 10';
	fi;
	if [ -d "/usr/share/icons/Numix-Circle" ]; then
		gsettings set org.gnome.desktop.interface icon-theme 'Numix-Circle';
		gsettings set org.cinnamon.desktop.interface icon-theme 'Numix-Circle';
		gsettings set org.mate.desktop.interface icon-theme 'Numix-Circle';
	fi;

	#Power #TODO: MATE
	echo "Do you want to enable auto suspend?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type 'suspend';
				gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'suspend';
				break;;
			No )
				gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type 'nothing';
				gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'nothing';
				break;;
		esac
	done

	#Search
	echo "Disabling GNOME Search Providers... (https://developer.gnome.org/documentation/tutorials/search-provider.html)";
	gsettings set org.gnome.desktop.search-providers disable-external true;

	echo "Disabling File Indexing...";

	gsettings set org.freedesktop.Tracker3.Miner.Files enable-monitors false;
	gsettings set org.freedesktop.Tracker3.Miner.Files crawling-interval -2;
	systemctl mask --user --now tracker-miner-fs-3.service || true;
	tracker3 reset -s || true;

	#Themes
	echo "Enabling dark mode...";
	gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark';
	gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark';
	gsettings set org.cinnamon.theme name 'Mint-Y-Dark';
	gsettings set org.cinnamon.desktop.interface gtk-theme 'Mint-Y-Dark';
	gsettings set org.cinnamon.desktop.wm.preferences theme 'Mint-Y-Dark';
	gsettings set org.mate.desktop.interface gtk-theme 'BlackMATE';
	gsettings set org.mate.marco.general theme 'BlackMATE';

fi;

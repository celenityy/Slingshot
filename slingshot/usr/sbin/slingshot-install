#!/bin/bash

coloroff='\e[0m';
black='\e[0;30m';
blue='\e[0;34m';
cyan='\e[0;36m';
green='\e[0;32m';
purple='\e[0;35m';
red='\e[0;31m';
white='\e[0;37m';
yellow='\e[0;33m';

if [ "$(/usr/bin/id -u)" -ne "0" ]; then echo -e "${red}ERROR: This script needs to be run as root!${coloroff}"; exit 1; fi;

if [ -f /etc/fedora-release ]; then
	echo "${purple}Welcome! This will allow you to easily install high-quality software from different categories.${coloroff}";
	echo "${purple}Nothing will be installed without your permission. You will be asked for each app.${coloroff}";
	echo "${purple}If you don't want any apps from a category, you can simply choose no to skip it!${coloroff}";
	echo "";

	echo "Would you like to install any web browsers?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo "Firefox? (Recommended, Preinstalled)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo "${red}Installing Firefox...${coloroff}";
								dnf install firefox;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								echo "Harden with Phoenix? https://phoenix.celenity.dev (Recommended)";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											bash -c "$(curl -fsSL https://phoenix.celenity.dev/fedora_install.sh)";
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo "Brave?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Adding Brave's Repository...${coloroff}";
								dnf config-manager addrepo --id=brave-browser --set=name='Brave Browser' --set=baseurl='https://brave-browser-rpm-release.s3.brave.com/$basearch';
								rpm --import https://brave-browser-rpm-release.s3.brave.com/brave-core.asc;
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo "${red}Installing Brave...${coloroff}";
								dnf install brave-browser;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								break;;
							No )
								break;;
						esac
					done
				echo "Hardened Chromium?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Adding secureblue's hardened-chromium COPR...${coloroff}";
								dnf copr enable secureblue/hardened-chromium;
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo "${red}Installing Hardened Chromium...${coloroff}";
								dnf install hardened-chromium;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								break;;
							No )
								break;;
						esac
					done
				echo "Mullvad Browser?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Adding Mullvad's Repository...${coloroff}";
								dnf config-manager addrepo --from-repofile='https://repository.mullvad.net/rpm/stable/mullvad.repo';
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo "${red}Installing Mullvad Browser...${coloroff}";
								dnf install mullvad-browser;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								break;;
							No )
								break;;
						esac
					done
				echo "Tor Browser?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo "${red}Installing Tor Browser...${coloroff}";
								dnf install tor torbrowser-launcher;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								break;;
							No )
								break;;
						esac
					done		
				break;;
			No )
				break;;
		esac
	done

	echo "Would you like to install software for Development?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo "Fedora's Recommended Developer Tools?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update;
								echo "${red}Installing the "Development Tools" group...${coloroff}";
								dnf group install development-tools --with-optional;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								break;;
							No )
								break;;
						esac
					done
				echo "General Development Languages/Support/Dependencies?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update;
								echo "${red}Installing General Development Languages/Support/Dependencies...${coloroff}";
								dnf install install cargo cmake coreutils copr-rpmbuild fedpkg git-core make maven mercurial mock pacman perl proguard rpkg rpm-build rpmdevtools rpmlint ruby rust;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								break;;
							No )
								break;;
						esac
					done				
				echo "nano?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update;
								echo "${red}Installing nano...${coloroff}";
								dnf install nano;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								break;;
							No )
								break;;
						esac
					done
				echo "VSCodium?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Adding VSCodium's Repository...${coloroff}";
								dnf config-manager addrepo --from-repofile='https://slingshot.celenity.dev/vscodium.repo';
								echo "${red}Updating DNF cache...${coloroff}";
								dnf update --refresh;
								echo "${red}Installing VSCodium...${coloroff}";
								dnf install codium;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo "Would you like to install software for compatibility with Android devices?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo "ADB?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo "${red}Installing ADB...${coloroff}";
								dnf install android-tools;
								echo "${red}Adding android-udev-rules COPR...${coloroff}";
								dnf copr enable nielsenb/android-udev-rules;
								echo "${red}Installing android-udev-rules...${coloroff}";
								dnf install android-udev-rules;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								break;;
							No )
								break;;
						esac
					done
				echo "Android Studio?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing Android Studio...${coloroff}";
								flatpak --user install com.google.AndroidStudio;
								echo "${red}Giving Android Studio necessary permissions...${coloroff}";
								flatpak --user override com.google.AndroidStudio --device=dri --device=kvm --share=network;
								break;;
							No )
								break;;
						esac
					done				
				echo "enjarify?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo "${red}Installing enjarify...${coloroff}";
								dnf install enjarify;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo "Would you like to install software for virtualization?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo "Fedora's Recommended Virtualization Software?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update;
								echo "${red}Installing the "Virtualization" group...${coloroff}";
								dnf group install virtualization --with-optional;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo "Would you like to install software for communication?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo "Signal?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing Signal...${coloroff}";
								flatpak --user install org.signal.Signal;
								echo "${red}Giving Signal necessary permissions...${coloroff}";
								flatpak --user override org.signal.Signal --share=network --socket=pulseaudio;
								echo "${red}Enabling Wayland Support...${coloroff}";
								flatpak --user override org.signal.Signal --env=ELECTRON_OZONE_PLATFORM_HINT=auto;
								break;;
							No )
								break;;
						esac
					done
				echo "Thunderbird?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo "${red}Installing Thunderbird...${coloroff}";
								dnf install thunderbird;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								echo "Harden with Dove? https://dove.celenity.dev (Recommended)";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											bash -c "$(curl -fsSL https://dove.celenity.dev/fedora_install.sh)";
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo "Would you like to install software for media consumption?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo "VLC?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Removing RPM if already installed...${coloroff}";
								dnf remove vlc;
								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing VLC...${coloroff}";
								flatpak --user install org.videolan.VLC org.videolan.VLC.Plugin.pause_click org.videolan.VLC.Plugin.fdkaac org.videolan.VLC.Plugin.bdj org.videolan.VLC.Plugin.makemkv;
								echo "${red}Giving VLC necessary permissions...${coloroff}";
								flatpak --user override org.videolan.VLC --device=dri --share=network --socket=pulseaudio --nosocket=wayland --socket=fallback-x11;
								break;;
							No )
								break;;
						esac
					done
				echo "Kodi?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Removing RPM if already installed...${coloroff}";
								dnf remove kodi;
								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing Kodi...${coloroff}";
								flatpak --user install tv.kodi.Kodi;
								echo "${red}Giving Kodi necessary permissions...${coloroff}";
								flatpak --user override tv.kodi.Kodi --device=dri --share=network --socket=pulseaudio;
								break;;
							No )
								break;;
						esac
					done
				echo "MakeMKV?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing MakeMKV...${coloroff}";
								flatpak --user install com.makemkv.MakeMKV;
								echo "${red}Giving MakeMKV necessary permissions...${coloroff}";
								flatpak --user override com.makemkv.MakeMKV --share=network;
								break;;
							No )
								break;;
						esac
					done
				echo "qBittorrent?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Removing RPM if already installed...${coloroff}";
								dnf remove qbittorrent;
								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing qBittorrent...${coloroff}";
								flatpak --user install org.qbittorrent.qBittorrent;
								echo "${red}Giving qBittorrent necessary permissions...${coloroff}";
								flatpak --user override org.qbittorrent.qBittorrent --share=network;
								break;;
							No )
								break;;
						esac
					done
				echo "Lollypop?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Removing RPM if already installed...${coloroff}";
								dnf remove lollypop;
								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing Lollypop...${coloroff}";
								flatpak --user install org.gnome.Lollypop;
								break;;
							No )
								break;;
						esac
					done
				echo "yt-dlp?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo "${red}Installing yt-dlp...${coloroff}";
								dnf install yt-dlp;
								echo "${red}Updating Firejail...${coloroff}";
								firecfg;
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo "Would you like to install software for content creation?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo "Audacity?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Removing RPM if already installed...${coloroff}";
								dnf remove audacity audacity-freeworld;
								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing Audacity...${coloroff}";
								flatpak --user install org.audacityteam.Audacity;
								echo "${red}Giving Audacity necessary permissions...${coloroff}";
								flatpak --user override org.audacityteam.Audacity --socket=pulseaudio;
								break;;
							No )
								break;;
						esac
					done
				echo "GIMP?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Removing RPM if already installed...${coloroff}";
								dnf remove gimp;
								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing GIMP...${coloroff}";
								flatpak --user install org.gimp.GIMP;
								break;;
							No )
								break;;
						esac
					done
				echo "HandBrake?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Removing RPM if already installed...${coloroff}";
								dnf remove handbrake;
								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing HandBrake...${coloroff}";
								flatpak --user install fr.handbrake.ghb;
								break;;
							No )
								break;;
						esac
					done
				echo "Kdenlive?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Removing RPM if already installed...${coloroff}";
								dnf remove kdenlive;
								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing Kdenlive...${coloroff}";
								flatpak --user install org.kde.kdenlive;
								break;;
							No )
								break;;
						esac
					done		
				echo "OBS?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Removing RPM if already installed...${coloroff}";
								dnf remove obs-studio;
								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing OBS...${coloroff}";

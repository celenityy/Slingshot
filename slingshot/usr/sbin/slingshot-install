								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.DolphinEmu.dolphin-emu --socket=pulseaudio;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Dolphin will perform poorly without direct access to your GPU for hardware acceleration.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.DolphinEmu.dolphin-emu --device=dri;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Dolphin requires network access for online multiplayer & other functionality.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.DolphinEmu.dolphin-emu --share=network;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "PPSSPP? (PSP, Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing PPSSPP...${coloroff}";
								flatpak --user install org.ppsspp.PPSSPP;
								echo -e "${red}PPSSPP will not launch without access to the X11 windowing system.${coloroff}";

								break;;
							No )
								break;;
						esac
					done
				echo -e "ProtonVPN? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing ProtonVPN...${coloroff}";
								flatpak --user install com.protonvpn.www;

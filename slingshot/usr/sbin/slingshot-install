								break;;
						esac
					done
				echo -e "Bottles? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing Bottles...${coloroff}";
								flatpak --user install com.usebottles.bottles;
								echo -e "${red}Bottles will not function without network access.${coloroff}";

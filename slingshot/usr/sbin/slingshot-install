											flatpak --user override com.protonvpn.www --share=network;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo -e "Would you like to install software for productivity?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo -e "Obsidian? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing Obsidian...${coloroff}";
								flatpak --user install md.obsidian.Obsidian;
								echo -e "${red}Obsidian requires network access for Sync & add-on installation/updates..${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )

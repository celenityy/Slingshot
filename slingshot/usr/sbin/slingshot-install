								echo "${red}Updating Flatpak Cache...${coloroff}";
								flatpak update;
								echo "${red}Installing Steam...${coloroff}";
								flatpak --user install com.valvesoftware.Steam com.valvesoftware.Steam.Utility.steamtinkerlaunch com.valvesoftware.Steam.CompatibilityTool.Proton-GE com.valvesoftware.Steam.Utility.InhibitScreensaver;
								echo "${red}Giving Steam necessary permissions...${coloroff}";
								flatpak --user override com.valvesoftware.Steam --device=dri --share=network --socket=pulseaudio --nosocket=wayland --socket=fallback-x11;
								echo "${red}Disabling hardened_malloc for Steam (Causes it to break)...${coloroff}";
								flatpak --user override com.valvesoftware.Steam --nofilesystem=host-os --unset-env=LD_PRELOAD;
								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo "${red}Installing WINE...${coloroff}";
								dnf install wine;
								echo "${red}Installing ProtonUp-Qt... (Allows easily installing, updating, & managing Proton, Proton-GE, & Wine)${coloroff}";
								flatpak --user install net.davidotek.pupgui2;
								echo "${red}Giving ProtonUp-Qt necessary permissions...${coloroff}";
								flatpak --user override net.davidotek.pupgui2 --share=network;

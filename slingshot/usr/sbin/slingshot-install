									done
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo -e "Would you like to install any Emulators?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo -e "RetroArch? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing RetroArch...${coloroff}";
								flatpak --user install org.libretro.RetroArch;

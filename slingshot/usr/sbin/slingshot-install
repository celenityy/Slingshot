											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Obsidian requires access to a directory on your system for saving notes.${coloroff}";
								echo -e "By default, we can grant it access to its own folder located at ~/Documents/Obsidian";
								echo -e "${red}Make sure to set this as your vault location during Obsidian's Set-up!${coloroff}";
								echo -e "Do you accept this?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											mkdir -p ~/Documents/Obsidian;
											flatpak --user override md.obsidian.Obsidian --filesystem=xdg-documents/Obsidian;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "LibreOffice? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Removing RPM if already installed...${coloroff}";
								dnf remove libreoffice-core;
								echo -e "${red}Installing LibreOffice..${coloroff}";
								flatpak --user install org.libreoffice.LibreOffice;
								break;;
							No )
								break;;
						esac
					done								
				echo -e "OnlyOffice? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing OnlyOffice...${coloroff}";
								flatpak --user install org.onlyoffice.desktopeditors;
								echo -e "${red}OnlyOffice will not launch without access to the X11 windowing system.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.onlyoffice.desktopeditors --socket=x11;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo -e "${red}Cleaning up DNF...${coloroff}";
	dnf autoremove;
	dnf clean all;

	echo -e "${red}Updating DNF Cache...${coloroff}";
	dnf update --refresh;

	echo -e "${red}Updating Flatpak Cache...${coloroff}";
	flatpak --system update;
	flatpak --user update;

	echo -e "${red}Updating Firejail...${coloroff}";
	firecfg;

fi;
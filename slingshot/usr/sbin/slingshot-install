								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.libretro.RetroArch --share=network;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}RetroArch requires access to PulseAudio for audio playback.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.libretro.RetroArch --socket=pulseaudio;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}RetroArch will perform poorly without direct access to your GPU for hardware acceleration.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.libretro.RetroArch --device=dri;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}RetroArch requires access to a directory on your system for scanning & playing ROMs.${coloroff}";
								echo -e "By default, we can grant it read-only access to ~/ROMs";
								echo -e "Do you accept this?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											mkdir -p ~/ROMs;
											flatpak --user override org.libretro.RetroArch --filesystem=~/ROMs:ro;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "Dolphin? (GameCube/Wii, Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing Dolphin...${coloroff}";
								flatpak --user install org.DolphinEmu.dolphin-emu;
								echo -e "${red}Dolphin will not launch without access to the X11 windowing system.${coloroff}";

											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Bottles requires access to PulseAudio for audio input & playback.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override com.usebottles.bottles --socket=pulseaudio;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Software will perform poorly without direct access to your GPU for hardware acceleration.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override com.usebottles.bottles --device=dri;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "Protontricks? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing Protontricks...${coloroff}";
								flatpak --user install com.github.Matoking.protontricks;
								break;;
							No )
								break;;
						esac
					done
				echo -e "ProtonUp-Qt? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing ProtonUp-Qt...${coloroff}";

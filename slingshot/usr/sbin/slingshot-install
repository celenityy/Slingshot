							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo "Would you like to install a VPN?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo "IVPN?";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo "${red}Adding IVPN's Repository...${coloroff}";

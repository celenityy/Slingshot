										Yes )
											flatpak --user override org.ppsspp.PPSSPP --socket=pulseaudio;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}PPSSPP will perform poorly without direct access to your GPU for hardware acceleration.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.ppsspp.PPSSPP --device=dri;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}PPSSPP requires network access for online multiplayer.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.ppsspp.PPSSPP --share=network;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}PPSSPP requires access to a directory on your system for scanning & playing ROMs.${coloroff}";
								echo -e "By default, we can grant it read-only access to ~/ROMs";
								echo -e "Do you accept this?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											mkdir -p ~/ROMs;
											flatpak --user override org.ppsspp.PPSSPP --filesystem=~/ROMs:ro;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo -e "Would you like to install a VPN?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo -e "IVPN? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Adding IVPN's Repository...${coloroff}";
								dnf config-manager addrepo --from-repofile='https://repo.ivpn.net/stable/fedora/generic/ivpn.repo';
								echo -e "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo -e "${red}Installing IVPN...${coloroff}";
								dnf install ivpn ivpn-ui;
								break;;
							No )
								break;;
						esac
					done
				echo -e "Mullvad? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Adding Mullvad's Repository...${coloroff}";
								dnf config-manager addrepo --from-repofile='https://repository.mullvad.net/rpm/stable/mullvad.repo';
								echo -e "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo -e "${red}Installing Mullvad...${coloroff}";

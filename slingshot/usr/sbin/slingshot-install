#!/bin/bash

coloroff='\e[0m';
black='\e[0;30m';
blue='\e[0;34m';
cyan='\e[0;36m';
green='\e[0;32m';
purple='\e[0;35m';
red='\e[0;31m';
white='\e[0;37m';
yellow='\e[0;33m';

if [ "$(/usr/bin/id -u)" -ne "0" ]; then echo -e "${red}ERROR: This script needs to be run as root!${coloroff}"; exit 1; fi;

if [ -f /etc/fedora-release ]; then
	echo -e "${purple}Welcome! This will allow you to easily install high-quality software from different categories.${coloroff}";
	echo -e "${purple}Nothing will be installed without your permission. You will be asked for each app.${coloroff}";
	echo -e "${purple}If you don't want any apps from a category, you can simply choose no to skip it!${coloroff}";
	echo -e "";

	echo -e "${red}Cleaning up DNF...${coloroff}";
	dnf autoremove;
	dnf clean all;

	echo -e "${red}Updating DNF Cache...${coloroff}";
	dnf update --refresh;

	echo -e "${red}Updating Flatpak Cache...${coloroff}";
	flatpak --system update;
	flatpak --user update;

	echo -e "${red}Updating Firejail...${coloroff}";
	firecfg;

	echo -e "Would you like to install any web browsers?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo -e "Firefox? (RPM, Recommended, Preinstalled)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo -e "${red}Installing Firefox...${coloroff}";
								dnf install firefox;
								echo -e "Harden with Phoenix? https://phoenix.celenity.dev (Recommended)";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											bash -c "$(curl -fsSL https://phoenix.celenity.dev/fedora_install.sh)";
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "Brave? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Adding Brave's Repository...${coloroff}";
								dnf config-manager addrepo --id=brave-browser --set=name='Brave Browser' --set=baseurl='https://brave-browser-rpm-release.s3.brave.com/$basearch';
								rpm --import https://brave-browser-rpm-release.s3.brave.com/brave-core.asc;
								echo -e "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo -e "${red}Installing Brave...${coloroff}";
								dnf install brave-browser;
								break;;
							No )
								break;;
						esac
					done
				echo -e "Hardened Chromium? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Adding secureblue's hardened-chromium COPR...${coloroff}";
								dnf copr enable secureblue/hardened-chromium;
								echo -e "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo -e "${red}Installing Hardened Chromium...${coloroff}";
								dnf install hardened-chromium;
								break;;
							No )
								break;;
						esac
					done
				echo -e "Mullvad Browser? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Adding Mullvad's Repository...${coloroff}";
								dnf config-manager addrepo --from-repofile='https://repository.mullvad.net/rpm/stable/mullvad.repo';
								echo -e "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo -e "${red}Installing Mullvad Browser...${coloroff}";
								dnf install mullvad-browser;
								break;;
							No )
								break;;
						esac
					done
				echo -e "Tor Browser? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo -e "${red}Installing Tor Browser...${coloroff}";
								dnf install tor torbrowser-launcher;
								break;;
							No )
								break;;
						esac
					done		
				break;;
			No )
				break;;
		esac
	done

	echo -e "Would you like to install software for Development?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo -e "Fedora's Recommended Developer Tools? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo -e "${red}Installing the "Development Tools" group...${coloroff}";
								dnf group install development-tools;
								break;;
							No )
								break;;
						esac
					done
				echo -e "General Development Languages/Support/Dependencies? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo -e "${red}Installing General Development Languages/Support/Dependencies...${coloroff}";
								dnf install cargo cmake coreutils copr-rpmbuild fedpkg git-core make maven mercurial mock pacman perl proguard rpkg rpm-build rpmdevtools rpmlint ruby rust;
								break;;
							No )
								break;;
						esac
					done				
				echo -e "nano? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing nano...${coloroff}";
								dnf install nano;
								break;;
							No )
								break;;
						esac
					done
				echo -e "VSCodium? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Adding VSCodium's Repository...${coloroff}";
								dnf config-manager addrepo --from-repofile='https://slingshot.celenity.dev/vscodium.repo';
								echo -e "${red}Updating DNF cache...${coloroff}";
								dnf update --refresh;
								echo -e "${red}Installing VSCodium...${coloroff}";
								dnf install codium;
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo -e "Would you like to install software for compatibility with Android devices?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo -e "ADB? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing ADB...${coloroff}";
								dnf install android-tools;
								break;;
							No )
								break;;
						esac
					done
				echo -e "Android Studio? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing Android Studio...${coloroff}";
								flatpak --user install com.google.AndroidStudio;
								echo -e "${red}Granting Android Studio necessary permissions...${coloroff}";
								mkdir -p ~/.android;
								flatpak --user override com.google.AndroidStudio --device=dri --device=kvm --share=network --filesystem=~/.android;
								break;;
							No )
								break;;
						esac
					done				
				echo -e "enjarify? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing enjarify...${coloroff}";
								dnf install enjarify;
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo -e "Would you like to install software for virtualization?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo -e "Fedora's Recommended Virtualization Software? (RPM)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing the "Virtualization" group...${coloroff}";
								dnf group install virtualization --with-optional;
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo -e "Would you like to install software for communication?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo -e "Signal? (Flatpak, Recommended)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing Signal...${coloroff}";
								flatpak --user install org.signal.Signal;
								echo -e "${red}Signal will not function without network access.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.signal.Signal --share=network;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Signal requires access to PulseAudio for audio input & playback.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.signal.Signal --socket=pulseaudio;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Signal requires access to your connected devices for sharing your webcam.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.signal.Signal --device=all;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "Thunderbird? (RPM, Recommended)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing Thunderbird...${coloroff}";
								dnf install thunderbird;
								echo -e "Harden with Dove? https://dove.celenity.dev (Recommended)";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											bash -c "$(curl -fsSL https://dove.celenity.dev/fedora_install.sh)";
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "Proton Mail Bridge? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing Proton Mail Bridge...${coloroff}";
								flatpak --user install ch.protonmail.protonmail-bridge;
								echo -e "${red}Proton Mail Bridge will not function without network access.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override ch.protonmail.protonmail-bridge --share=network;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo -e "Would you like to install software for Finance?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo -e "Cake Wallet? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Downloading Cake Wallet...${coloroff}";
								wget https://github.com/cake-tech/cake_wallet/releases/download/v4.20.1/Cake_Wallet_v4.20.1_Linux.flatpak;
								echo -e "${red}Installing Cake Wallet...${coloroff}";
								flatpak --user install Cake_Wallet_v4.20.1_Linux.flatpak;
								echo -e "${red}Cake Wallet will not launch with hardened_malloc.${coloroff}";
								echo -e "Do you grant it an exception?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override com.cakewallet.CakeWallet --nofilesystem=host-os --unset-env=LD_PRELOAD;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Cake Wallet will not function without network access.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override com.cakewallet.CakeWallet --share=network;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				break;;
			No )
				break;;
		esac
	done

	echo -e "Would you like to install software for media consumption?";
	select yn in "Yes" "No"; do
		case $yn in
			Yes )
				echo -e "VLC? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Removing RPM if already installed...${coloroff}";
								dnf remove vlc;
								echo -e "${red}Installing VLC...${coloroff}";
								flatpak --user install org.videolan.VLC org.videolan.VLC.Plugin.pause_click org.videolan.VLC.Plugin.fdkaac org.videolan.VLC.Plugin.bdj org.videolan.VLC.Plugin.makemkv;
								echo -e "${red}VLC will not launch without access to the X11 windowing system.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.videolan.VLC --nosocket=wayland --socket=fallback-x11;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}VLC requires access to PulseAudio for audio playback.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.videolan.VLC --socket=pulseaudio;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}VLC requires direct access to your GPU for hardware acceleration.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.videolan.VLC --device=dri;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}VLC requires network access for downloading & updating metadata.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.videolan.VLC --share=network;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "Lollypop? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Removing RPM if already installed...${coloroff}";
								dnf remove lollypop;
								echo -e "${red}Installing Lollypop...${coloroff}";
								flatpak --user install org.gnome.Lollypop;
								echo -e "${red}Lollypop requires access to PulseAudio for audio playback.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.gnome.Lollypop --socket=pulseaudio;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Lollypop requires network access for downloading & updating metadata.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.gnome.Lollypop --share=network;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "qBittorrent? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Removing RPM if already installed...${coloroff}";
								dnf remove qbittorrent;
								echo -e "${red}Installing qBittorrent...${coloroff}";
								flatpak --user install org.qbittorrent.qBittorrent;
								echo -e "${red}qBittorrent will not function without network access.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override org.qbittorrent.qBittorrent --share=network;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "Kodi? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Removing RPM if already installed...${coloroff}";
								dnf remove kodi;
								echo -e "${red}Installing Kodi...${coloroff}";
								flatpak --user install tv.kodi.Kodi;
								echo -e "${red}Kodi requires access to PulseAudio for audio playback.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override tv.kodi.Kodi --socket=pulseaudio;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Kodi requires direct access to your GPU for hardware acceleration.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override tv.kodi.Kodi --device=dri;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Kodi requires network access for remote playback & add-on installation/updates.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override tv.kodi.Kodi --share=network;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "NewPipe? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing NewPipe..${coloroff}";
								flatpak --user install net.newpipe.NewPipe;
								echo -e "${red}NewPipe will not function without network access.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override net.newpipe.NewPipe --share=network;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}NewPipe requires access to PulseAudio for audio playback.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override net.newpipe.NewPipe --socket=pulseaudio;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}NewPipe requires direct access to your GPU for hardware acceleration.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override net.newpipe.NewPipe --device=dri;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "Jellyfin Media Player? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing Jellyfin Media Player...${coloroff}";
								flatpak --user install com.github.iwalton3.jellyfin-media-player;
								echo -e "${red}Jellyfin will not function without network access.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override com.github.iwalton3.jellyfin-media-player --share=network;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Jellyfin requires access to PulseAudio for audio playback.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override com.github.iwalton3.jellyfin-media-player --socket=pulseaudio;
											break;;
										No )
											break;;
										esac
									done
								break;;
							No )
								break;;
						esac
					done
				echo -e "Jellyfin MPV Shim? (Flatpak)";
				select yn in "Yes" "No"; do
					case $yn in
							Yes )
								echo -e "${red}Installing Jellyfin MPV Shim...${coloroff}";
								flatpak --user install com.github.iwalton3.jellyfin-mpv-shim;
								echo -e "${red}Jellyfin MPV Shim will not launch without access to the X11 windowing system.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override com.github.iwalton3.jellyfin-mpv-shim --socket=x11;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Jellyfin MPV Shim will not function without network access.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override com.github.iwalton3.jellyfin-mpv-shim --share=network;
											break;;
										No )
											break;;
										esac
									done
								echo -e "${red}Jellyfin MPV Shim requires access to PulseAudio for audio playback.${coloroff}";
								echo -e "Do you grant this permission?";
								select yn in "Yes" "No"; do
									case $yn in
										Yes )
											flatpak --user override com.github.iwalton3.jellyfin-mpv-shim --socket=pulseaudio;
											break;;
										No )
											break;;

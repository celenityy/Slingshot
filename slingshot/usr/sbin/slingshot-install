								echo "${red}Updating DNF Cache...${coloroff}";
								dnf update --refresh;
								echo "${red}Installing Mullvad...${coloroff}";
								dnf install mullvad-vpn;
								break;;
							No )
								break;;
						esac
					done
				echo "ProtonVPN?";
				select yn in "Yes" "No"; do
